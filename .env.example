# Neon Postgres pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Signs access tokens. Generate with:  openssl rand -base64 32
# Changing it invalidates every access token immediately.
AUTH_SECRET="replace-me-with-32-random-bytes"

# Comma-separated list of frontend origins allowed to call this API.
# No trailing slashes. Requests from anything else are rejected by CORS.
CORS_ORIGINS="http://localhost:5173,https://your-frontend.example.com"

# Port to listen on. Most hosts inject this themselves.
PORT=8080

# Used once by `npm run db:migrate` to create the first admin.
ADMIN_EMAIL="admin@farverde.com"
ADMIN_PASSWORD="choose-something-long-and-random"
ADMIN_NAME="Desk Administrator"
